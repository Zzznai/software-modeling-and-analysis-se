          {
            "name": "FactPayments",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(\"localhost\", \"SpotifyDW\"),",
                "    Data = Source{[Schema=\"dbo\",Item=\"FactPayments\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Revenue",
            "expression": "CALCULATE ( SUM ( FactPayments[Amount] ), FactPayments[IsSuccessful] = TRUE () )",
            "formatString": "€#,0.00",
            "lineageTag": "70037fbe-ebf9-5040-8ff1-4766edaa8883"
          },
          {
            "name": "Paying Users",
            "expression": "CALCULATE ( DISTINCTCOUNT ( FactPayments[UserKey] ), FactPayments[IsSuccessful] = TRUE () )",
            "formatString": "#,0",
            "lineageTag": "b4fd309b-724f-5c1e-bd0e-dd9fb0263a95"
          },
          {
            "name": "ARPU",
            "expression": "DIVIDE ( [Revenue], [Paying Users] )",
            "formatString": "€#,0.00",
            "lineageTag": "71bc808a-1058-57b9-9880-9a059b8707eb"
          },
          {
            "name": "Failed Payments",
            "expression": "CALCULATE ( COUNTROWS ( FactPayments ), FactPayments[IsFailed] = TRUE () )",
            "formatString": "#,0",
            "lineageTag": "f7a2bf5c-613a-52fe-a373-8c72af60f80f"
          },
          {
            "name": "Refunded Amount",
            "expression": "SUM ( FactPayments[RefundedAmount] )",
            "formatString": "€#,0.00",
            "lineageTag": "4f4bef0a-869d-5142-a4f1-68d179fb6639"
          }
        ]

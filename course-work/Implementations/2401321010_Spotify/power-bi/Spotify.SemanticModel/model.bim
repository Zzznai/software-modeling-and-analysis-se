        "partitions": [
          {
            "name": "FactStreams",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(\"localhost\", \"SpotifyDW\"),",
                "    Data = Source{[Schema=\"dbo\",Item=\"FactStreams\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Streams",
            "expression": "COUNTROWS ( FactStreams )",
            "formatString": "#,0",
            "lineageTag": "7aa37d7c-9464-5185-9962-7d9543cc205c"
          },
          {
            "name": "Counted Streams",
            "expression": "CALCULATE ( COUNTROWS ( FactStreams ), FactStreams[IsCounted] = TRUE () )",
            "formatString": "#,0",
            "lineageTag": "24b37b53-8d3b-5065-9115-5b72d60ddad6"
          },
          {
            "name": "Hours Played",
            "expression": "DIVIDE ( SUM ( FactStreams[MinutesPlayed] ), 60 )",
            "formatString": "#,0",
            "lineageTag": "6133a9cb-86cd-5172-b5e0-f4308cc0210e"
          },
          {
            "name": "Active Listeners",
            "expression": "DISTINCTCOUNT ( FactStreams[UserKey] )",
            "formatString": "#,0",
            "lineageTag": "95fe78e6-4259-5a30-855d-15ad741b263f"
          },
          {
            "name": "Skip Rate",
            "expression": "DIVIDE ( CALCULATE ( COUNTROWS ( FactStreams ), FactStreams[IsSkipped] = TRUE () ), [Total Streams] )",
            "formatString": "0.0%",
            "lineageTag": "6de7c61f-5508-5dbc-9d92-2704dd2c4bd2"
          }
        ]
